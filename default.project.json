{
   "name": "Boomerang!",
   "tree": {
      "$className": "DataModel",
      "ReplicatedStorage": {
         "$className": "ReplicatedStorage",
         "$ignoreUnknownInstances": true,
         "Shared": {
            "$path": "src/Shared",
            "Packages": {
               "$path": "Packages"
            }
         },
         "Client": {
            "$path": "src/Client"
         }
      },
      "ServerStorage": {
         "$className": "ServerStorage",
         "$ignoreUnknownInstances": true,
         "Server": {
            "$path": "src/Server"
         },
         "Packages": {
            "$path": "ServerPackages"
         }
      },
      "ServerScriptService": {
         "$className": "ServerScriptService",
         "$ignoreUnknownInstances": true,
         "Server": {
            "$path": "src/Server.server.luau"
         }
      },
      "StarterPlayer": {
         "$className": "StarterPlayer",
         "$ignoreUnknownInstances": true,
         "PlayerModule": {
            "$path": "src/PlayerModule",
            "ServerAuthority": {
               "$className": "ModuleScript",
               "ServerAuthorityClient": {
                  "$className": "LocalScript",
                  "$properties": {
                     "Enabled": false
                  }
               },
               "ServerAuthorityServer": {
                  "$className": "Script",
                  "$properties": {
                     "Enabled": false
                  }
               }
            }
         },
         "StarterPlayerScripts": {
            "Client": {
               "$path": "src/Client.client.luau"
            }
         }
      }
   }
}